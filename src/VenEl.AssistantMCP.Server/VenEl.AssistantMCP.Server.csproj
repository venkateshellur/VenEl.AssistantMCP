<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>venel-mcp</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <Version>1.2.6</Version>
    <PackageId>VenEl.AssistantMCP</PackageId>
    <Authors>Venkatesh Ellur</Authors>
    <Description>MCP Server Assistant for interacting with various platforms via Anthropic / Claude Desktop.</Description>
    <RepositoryUrl>https://github.com/venkateshellur/VenEl.AssistantMCP</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VenEl.AssistantMCP.Core\VenEl.AssistantMCP.Core.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.Azure\VenEl.AssistantMCP.Azure.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.Logging\VenEl.AssistantMCP.Logging.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.Docker\VenEl.AssistantMCP.Docker.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.GitHub\VenEl.AssistantMCP.GitHub.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.MSSql\VenEl.AssistantMCP.MSSql.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.Atlassian\VenEl.AssistantMCP.Atlassian.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.LocalOffice\VenEl.AssistantMCP.LocalOffice.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.Slack\VenEl.AssistantMCP.Slack.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.Kubernetes\VenEl.AssistantMCP.Kubernetes.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.AWS\VenEl.AssistantMCP.AWS.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.GCP\VenEl.AssistantMCP.GCP.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.Databricks\VenEl.AssistantMCP.Databricks.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.Bitwarden\VenEl.AssistantMCP.Bitwarden.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.MicrosoftTeams\VenEl.AssistantMCP.MicrosoftTeams.csproj" />
    <ProjectReference Include="..\VenEl.AssistantMCP.Email\VenEl.AssistantMCP.Email.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensure appsettings.json is present next to the executable at runtime -->
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="EnableBitwardenOnPublish" AfterTargets="Publish">
    <Message Text="Automatically enabling Bitwarden integration in the published appsettings.json..." Importance="high" />
    <!-- macOS uses sed -i '' -->
    <Exec Command="sed -i '' 's/&quot;IsEnabled&quot;: false/&quot;IsEnabled&quot;: true/g' &quot;$(PublishDir)appsettings.json&quot;" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <!-- Linux uses sed -i -->
    <Exec Command="sed -i 's/&quot;IsEnabled&quot;: false/&quot;IsEnabled&quot;: true/g' &quot;$(PublishDir)appsettings.json&quot;" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </Target>

</Project>
