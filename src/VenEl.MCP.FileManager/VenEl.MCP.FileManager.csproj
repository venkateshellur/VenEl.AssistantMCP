<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>VenEl.MCP.FileManager</PackageId>
    <Version>1.0.2</Version>
    <Authors>VenEl</Authors>
    <Description>An interactive, AI-powered file management MCP plugin. Bring your local file system natively into your AI IDEs with zero-click embedded UIs, fast search, and rich previews.</Description>
    <PackageTags>MCP;AI;LLM;FileManager;UI;IDE;VenEl</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VenEl.MCP.Core\VenEl.MCP.Core.csproj" />
    <ProjectReference Include="..\VenEl.MCP.Decompiler\VenEl.MCP.Decompiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\Static\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>


</Project>
