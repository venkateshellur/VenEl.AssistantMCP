{
  "MSSql": {
    // ──────────────────────────────────────────────────────────────────────────
    // Global safety switch.
    // When false (default), DELETE / TRUNCATE / DROP / UPDATE statements are
    // blocked across ALL servers.  Set to true to lift the restriction globally.
    // Individual servers can override this via their own AllowDestructiveOperations.
    // ──────────────────────────────────────────────────────────────────────────
    "AllowDestructiveOperations": false,
    "Servers": [
      {
        // Unique name used in every MCP tool call to identify this server.
        "Name": "LocalDev",
        "ConnectionString": "Server=localhost;Integrated Security=true;TrustServerCertificate=true;",
        "DefaultDatabase": "master",
        "Description": "Local development SQL Server instance (Windows Auth)",
        // null = inherit global AllowDestructiveOperations
        // true / false = override for this server only
        "AllowDestructiveOperations": null
      }
      // ── Add more servers below ─────────────────────────────────────────────
      // {
      //   "Name": "Staging",
      //   "ConnectionString": "Server=staging-sql.example.com;User Id=sa;Password=***;TrustServerCertificate=true;",
      //   "DefaultDatabase": "MyApp",
      //   "Description": "Staging environment – read-only access",
      //   "AllowDestructiveOperations": false
      // },
      // {
      //   "Name": "ReportingServer",
      //   "ConnectionString": "Server=rpt-sql.example.com;Integrated Security=true;TrustServerCertificate=true;",
      //   "DefaultDatabase": "Reports",
      //   "Description": "Reporting warehouse – SELECT queries only"
      // }
    ]
  },
  "Atlassian": {
    // ──────────────────────────────────────────────────────────────────────────
    // Your Atlassian Cloud domain (without https://), e.g. "yourname.atlassian.net".
    // Used for Jira and Confluence. Bitbucket uses api.bitbucket.org automatically.
    // ──────────────────────────────────────────────────────────────────────────
    "Domain": "venkateshellur.atlassian.net",
    // Bitbucket workspace slug (the short name shown in Bitbucket URLs).
    "BitbucketWorkspace": "",
    // ──────────────────────────────────────────────────────────────────────────
    // Auth: set PreferredAuthMethod to "ApiToken" or "OAuth".
    // The other method is used automatically as fallback if preferred creds are missing.
    // ──────────────────────────────────────────────────────────────────────────
    "PreferredAuthMethod": "ApiToken",
    // API Token (Basic Auth) — simplest for personal use.
    // Generate at: https://id.atlassian.net/manage-profile/security/api-tokens
    "ApiToken": {
      "Email": "",
      "Token": ""
    },
    // OAuth 2.0 Client Credentials — register app at https://developer.atlassian.com/console/myapps/
    // One set of credentials covers Jira, Confluence, and Bitbucket.
    "OAuth": {
      "ClientId": "",
      "ClientSecret": ""
    }
  }
}